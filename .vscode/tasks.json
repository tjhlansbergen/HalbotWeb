{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: backend",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "watch",
        "run",
        "--launch-profile",
        "https"
      ],
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "owner": "csharp",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^dotnet watch",
          "endsPattern": "Now listening on:"
        }
      }
    },
    {
      "label": "dev: frontend",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "dev"
      ],
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/Frontend"
      },
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^> halbotweb-frontend@",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "dev: full stack",
      "dependsOn": [
        "dev: backend",
        "dev: frontend"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
